# LLM Stats Dashboard — Environment Variables
# Copy this file to backend/.env and edit values.

# Database
DATABASE_URL=postgresql+psycopg://lsd_user:lsd_pass@localhost:5432/lsd_dev
TEST_DATABASE_URL=postgresql+psycopg://lsd_user:lsd_pass@localhost:5432/lsd_test

# Security
SECRET_KEY=CHANGE_ME_in_production_at_least_32_chars_random
SESSION_MAX_AGE_SECONDS=28800
CSRF_TOKEN_MAX_AGE_SECONDS=28800

# App
APP_ENV=development
ALLOWED_ORIGINS=["http://localhost:5173"]
MAX_LOG_BODY_BYTES=1048576

# Logging
LOG_LEVEL=DEBUG
LOG_FILE=logs/lsd.log

# OpenRouter Proxy
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_REFERER=
OPENROUTER_APP_TITLE=LLM Stats Dashboard
# Available plugins: logging, compression, word_count, session_tracking
# - logging is always-on and cannot be disabled
# - session_tracking is default-enabled regardless of PROXY_PLUGINS
# Default: compression,logging (compression + session_tracking enabled by default)
PROXY_PLUGINS=compression,logging
PROXY_UPSTREAM_TIMEOUT_S=120
PROXY_STREAM_IDLE_TIMEOUT_S=120

# Headroom Compression (CPU-only, no GPU required)
# Tier 1: CompressConfig knobs
# COMPRESSION_PROTECT_ANALYSIS_CONTEXT=true   # detect "analyze/review" intent, protect code
# COMPRESSION_PROTECT_RECENT=4                # keep N most recent messages untouched
# COMPRESSION_COMPRESS_USER_MESSAGES=false    # compress user messages too (RAG/docs)
# COMPRESSION_COMPRESS_SYSTEM_MESSAGES=true   # compress system messages
# COMPRESSION_TARGET_RATIO=                   # None = auto; 0.5 = reduce to 50%
# COMPRESSION_MIN_TOKENS=250                  # minimum tokens to trigger compression
# COMPRESSION_KOMPRESS_MODEL=                 # "" = default ONNX; "disabled" = no ML text
# COMPRESSION_OPTIMIZE=true                   # A/B kill-switch: false = passthrough
# COMPRESSION_MODEL_LIMIT=200000              # context window override for token pressure
#
# Tier 2: per-transform pipeline config
# COMPRESSION_CACHE_ALIGNER_ENABLED=false      # prefix stabilization for KV-cache hits
# COMPRESSION_INTERCEPT_TOOLS=false            # ast-grep Read outline shrinking
# COMPRESSION_CCR_ENABLED=true                 # Compress-Cache-Retrieve markers
# COMPRESSION_CCR_INJECT_MARKER=true           # add retrieval hints to compressed content
# COMPRESSION_SMARTCRUSHER_MAX_ITEMS=15        # target max items in compressed arrays
# COMPRESSION_SMARTCRUSHER_MIN_TOKENS=200      # min tokens before SmartCrusher activates
# COMPRESSION_SMARTCRUSHER_PROFILE=moderate    # "conservative"|"moderate"|"aggressive"
# COMPRESSION_READ_COMPRESS_SUPERSEDED=false   # compress superseded Read outputs
# HEADROOM_TELEMETRY=false                     # disable anonymous telemetry
